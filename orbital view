<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ceres Drift — TPP Flight Console</title>
  <style>
    :root {
      color-scheme: dark;
      --ink: #f2ede8;
      --muted: #b7b5c2;
      --accent: #ffa57b;
      --line: #e0e0ff32;
      --pad: clamp(22px, 4.3vw, 72px);
      --mono: "SFMono-Regular", Consolas, monospace;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body {
      margin: 0; height: 100dvh; overflow: hidden;
      background: #080912; color: var(--ink);
      font: 16px/1.4 system-ui, sans-serif;
    }
    #space, .shade { position: fixed; inset: 0; width: 100%; height: 100%; }
    #space { display: block; outline: none; touch-action: none; }
    #space.drag-mode { cursor: grab; }
    #space.dragging { cursor: grabbing; }
    .shade {
      pointer-events: none;
      background:
        linear-gradient(0deg, #080912ee 0%, #08091278 13%, transparent 40%),
        linear-gradient(180deg, #080912c2, transparent 19%),
        radial-gradient(ellipse at 58% 41%, transparent 45%, #08091265 100%);
    }
    header, footer {
      position: absolute; left: var(--pad); right: var(--pad);
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; pointer-events: none;
    }
    header { top: 24px; padding-bottom: 17px; border-bottom: 1px solid var(--line); }
    footer { bottom: 20px; padding-top: 15px; border-top: 1px solid var(--line); }
    .brand { display: flex; align-items: center; gap: 12px; }
    .brand-mark {
      display: grid; place-items: center; width: 36px; height: 36px;
      color: var(--accent); border: 1px solid #ffa57b70;
      border-radius: 50%; font-size: 23px;
    }
    .brand strong { display: block; font-size: 15px; letter-spacing: .22em; }
    .mono { font-family: var(--mono); font-size: 10px; letter-spacing: .13em; text-transform: uppercase; }
    .brand small, .metrics small { display: block; color: var(--muted); }
    .status { display: flex; align-items: center; gap: 9px; color: var(--muted); }
    .status::before {
      content: ""; width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 12px #ffa57b95;
    }
    button { color: inherit; font: inherit; cursor: pointer; pointer-events: auto; }
    button:focus-visible { outline: 2px solid white; outline-offset: 5px; }
    #reset { padding: 9px 13px; background: #10101bcc; border: 1px solid var(--line); border-radius: 4px; }
    #reset:hover { border-color: var(--accent); }
    #reset span { margin-left: 6px; }
    .briefing {
      position: absolute; left: var(--pad); bottom: clamp(120px, 20vh, 200px);
      max-width: calc(100% - var(--pad) * 2); pointer-events: none;
    }
    .sector { display: flex; align-items: center; gap: 10px; color: var(--accent); }
    .sector::before { content: ""; width: 23px; height: 1px; background: currentColor; }
    h1 {
      margin: 9px 0 15px; font-size: clamp(52px, 8vw, 120px);
      line-height: .98; font-weight: 650; letter-spacing: -.078em;
    }
    .briefing p { margin: 0 0 23px; color: var(--muted); }
    #launch {
      display: inline-flex; align-items: center; justify-content: space-between;
      gap: 30px; padding: 13px 16px; min-height: 47px;
      background: var(--accent); border: 0; border-radius: 4px;
      color: #23130f; font-weight: 700;
    }
    #launch:hover { background: #ffc2a5; }
    #launch .arrow { font-size: 19px; }
    #loadModel {
      display: block; margin: 10px 0 0; padding: 9px 13px;
      background: #10101bcc; border: 1px solid #ffa57b70; border-radius: 4px; color: var(--accent);
    }
    #loadModel:hover { border-color: var(--accent); }
    .controls, .metrics { display: flex; align-items: center; gap: clamp(12px, 2vw, 30px); }
    .control { display: flex; align-items: center; gap: 7px; color: var(--muted); }
    kbd {
      display: inline-grid; place-items: center; min-height: 21px; padding: 0 5px;
      color: var(--ink); font: 10px var(--mono); background: #151520;
      border: 1px solid var(--line); border-radius: 3px;
    }
    .metrics > div { min-width: 65px; }
    .metrics output { display: block; font: 17px/1.5 var(--mono); white-space: nowrap; }
    .radar {
      position: absolute; right: var(--pad); bottom: 91px; width: 168px;
      padding: 11px 12px 8px; background: #0d101cc4;
      border: 1px solid var(--line); border-radius: 5px; pointer-events: none;
    }
    .radar-title { display: flex; justify-content: space-between; }
    .radar-title span { color: var(--muted); }
    #radar { display: block; width: 100%; height: auto; }
    .legend { display: flex; justify-content: center; gap: 12px; font: 9px var(--mono); }
    .legend i { display: inline-block; width: 5px; height: 5px; margin-right: 4px; }
    .rock-key { background: var(--accent); }
    .comet-key { background: #a4ecff; }
    #aim {
      position: absolute; left: 50%; top: 50%; width: 34px; height: 34px;
      transform: translate(-50%, -50%); border: 1px solid #e7ecff6b;
      border-radius: 50%; pointer-events: none;
    }
    #aim::before, #aim::after { content: ""; position: absolute; background: #fff9; inset: 15px 10px; }
    #aim::after { inset: 10px 15px; }
    .tag {
      position: absolute; transform: translateY(-50%); display: flex; align-items: center;
      gap: 7px; white-space: nowrap; pointer-events: none; color: #ffc4a9;
      text-shadow: 0 1px 7px #080912, 0 1px 7px #080912;
    }
    .tag::before { content: ""; width: 19px; height: 1px; background: currentColor; }
    #cometTag { color: #b5efff; }
    #error { max-width: 360px; color: #ffc4a9; }
    .overlay {
      position: fixed; inset: 0; display: grid; place-items: center;
      background: radial-gradient(ellipse at 50% 42%, #080912b8 0%, #080912f2 100%);
      pointer-events: auto; z-index: 20;
    }
    .panel {
      width: min(440px, calc(100% - 48px)); padding: 30px 32px 26px;
      background: #101018e8; border: 1px solid #ffa57b55; border-radius: 8px;
      box-shadow: 0 0 90px #ffa57b1c;
    }
    .panel h2 { margin: 10px 0 12px; font-size: clamp(28px, 4.5vw, 42px); letter-spacing: -.05em; color: #ff7a55; }
    .panel p { margin: 0 0 22px; color: var(--muted); }
    .panel-actions { display: flex; flex-direction: column; gap: 10px; }
    .panel-actions button {
      display: flex; justify-content: space-between; align-items: center;
      gap: 18px; padding: 12px 15px; min-height: 45px;
      border-radius: 4px; background: #15151f; border: 1px solid var(--line);
    }
    .panel-actions button:hover { border-color: var(--accent); }
    #restartFlight { background: var(--accent); border: 0; color: #23130f; font-weight: 700; }
    #restartFlight:hover { background: #ffc2a5; }
    @media (max-width: 780px) { .secondary-control { display: none; } .radar { width: 130px; } }
    @media (max-width: 590px), (max-height: 520px) {
      .radar, .tag, .status { display: none; }
      .briefing { bottom: 100px; } .briefing p { font-size: 14px; }
      .metrics .distance { display: none; } footer { gap: 8px; }
      .control { gap: 4px; } .mono { letter-spacing: .07em; }
    }
  </style>
</head>
<body>
  <canvas id="space" tabindex="-1" aria-label="Third-person 3D view of a spacecraft in an asteroid belt"></canvas>
  <div class="shade" aria-hidden="true"></div>

<header>
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">✦</span>
      <div><strong>KEPLER</strong><small class="mono">Flight console</small></div>
    </div>
    <div class="status mono" id="status" role="status">Standby</div>
    <button class="mono" id="reset" type="button" title="Reset position (R)">↻ <span>Reset position</span></button>
  </header>

<main class="briefing" id="briefing">
    <div class="sector mono">Sector 07 / Asteroid belt</div>
    <h1>Ceres Drift</h1>
    <p>Third-person free flight through a moving asteroid field. Don't hit the rocks.</p>
    <button id="launch" type="button"><span id="launchText">Begin flight</span><span class="arrow" aria-hidden="true">↗</span></button>
    <button id="loadModel" type="button" hidden>⇪ Load your spacecraft.glb</button>
    <input id="glbFile" type="file" accept=".glb" hidden>
    <p id="error" role="alert" hidden></p>
  </main>

<div id="aim" aria-hidden="true" hidden></div>
  <div class="tag mono" id="rockTag" aria-hidden="true" hidden>Asteroid A-01</div>
  <div class="tag mono" id="cometTag" aria-hidden="true" hidden>Comet C-01</div>

<aside class="radar" aria-label="Proximity radar">
    <div class="radar-title mono">Radar <span>180 u</span></div>
    <canvas id="radar" width="260" height="260" aria-label="Nearby objects"></canvas>
    <div class="legend">
      <span><i class="rock-key"></i>Asteroid</span>
      <span><i class="comet-key"></i>Comet</span>
    </div>
  </aside>

<footer>
    <div class="controls mono" aria-label="Flight controls">
      <span class="control"><kbd>WASD</kbd> Fly</span>
      <span class="control"><kbd id="lookKey">Mouse</kbd> Camera</span>
      <span class="control secondary-control"><kbd>Q / E</kbd> Descend / ascend</span>
      <span class="control secondary-control"><kbd>Shift</kbd> Boost</span>
      <span class="control secondary-control"><kbd>Z/X C/V B/N</kbd> Tune ship</span>
      <span class="control secondary-control"><kbd>Esc</kbd> Release</span>
    </div>
    <div class="metrics">
      <div><small class="mono">Speed</small><output id="speed">0 u/s</output></div>
      <div><small class="mono">Heading</small><output id="heading">000°</output></div>
      <div class="distance"><small class="mono">From start</small><output id="distance">0 u</output></div>
    </div>
  </footer>

<div class="overlay" id="gameOver" hidden>
    <div class="panel">
      <div class="sector mono">Signal lost — Sector 07</div>
      <h2>SHIP DESTROYED</h2>
      <p>Your spacecraft collided with asteroid debris. All systems reset to launch state.</p>
      <div class="panel-actions">
        <button id="restartFlight" type="button">Restart flight <span aria-hidden="true">↻</span></button>
        <button id="backToMenu" type="button">Back to main menu <span aria-hidden="true">⌂</span></button>
      </div>
    </div>
  </div>

<script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
    }
  }
  </script>

<script type="module">
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
    import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';

/* ================= tunables ================= */
    const SHIP_MODEL_URL = 'spacecraft.glb';
    const SHIP_LENGTH = 7;
    const SHIP_FIX_DEG = [0, 180, 0]; // 180 flip: nose forward, exhaust back. Live-tune keys: Z/X Y-spin, C/V X-tilt, B/N Z-roll
    const CHASE_BACK = 15, CHASE_UP = 3.2;
    const FLY_SPEED = 23, BOOST_SPEED = 57;
    const SHIP_HIT_PADDING = 1.15;
    const EXPLOSION_LIFE = 1.6;
    const TURN_RATE = 6;
    const DRIFT_DECAY = 1.6;

/* live ship-orientation tuning */
    let shipFix = null;
    function applyShipFix() {
      if (!shipFix) return;
      shipFix.rotation.set(
        THREE.MathUtils.degToRad(SHIP_FIX_DEG[0]),
        THREE.MathUtils.degToRad(SHIP_FIX_DEG[1]),
        THREE.MathUtils.degToRad(SHIP_FIX_DEG[2])
      );
      const s = byId('status');
      const note = 'Ship fix  X:' + SHIP_FIX_DEG[0] + '° Y:' + SHIP_FIX_DEG[1] + '° Z:' + SHIP_FIX_DEG[2] + '°';
      s.textContent = note;
      setTimeout(() => {
        if (s.textContent === note) s.textContent = dead ? 'Ship destroyed' : (flying ? 'Flight active' : 'Standby');
      }, 3000);
    }

/* ================= helpers ================= */
    const byId = id => document.getElementById(id);
    const canvas = byId('space');
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    const wrap = (v, span) => v - span * Math.floor(v / span + 0.5);
    const rnd = (lo, hi) => lo + Math.random() * (hi - lo);
    function angleDelta(from, to) {
      let d = (to - from) % (Math.PI * 2);
      if (d > Math.PI) d -= Math.PI * 2;
      if (d < -Math.PI) d += Math.PI * 2;
      return d;
    }

/* ================= state ================= */
    let renderer, scene, camera, radar;
    let ship = null, fallbackShip = null, mixer = null;
    let shipHitRadius = 3.2;
    const position = new THREE.Vector3(), prevPosition = new THREE.Vector3();
    const velocity = new THREE.Vector3();
    const desired = new THREE.Vector3(), camForward = new THREE.Vector3(), right = new THREE.Vector3();
    const camPos = new THREE.Vector3(), camAim = new THREE.Vector3(), tmpV = new THREE.Vector3();
    const offset = new THREE.Vector3(), headOff = new THREE.Vector3();
    const segB = new THREE.Vector3(), segA = new THREE.Vector3(), segClosest = new THREE.Vector3();
    const rockWorld = new THREE.Vector3();
    const keys = new Set();
    const flightKeys = new Set(['KeyW','KeyA','KeyS','KeyD','KeyQ','KeyE','ShiftLeft','ShiftRight','KeyR']);
    const rocks = [], comets = [];
    const asteroidGeos = [];
    const explosion = { active: false, points: null, vel: [], age: 0 };
    let yaw = 0, pitch = 0, roll = 0;
    let camYaw = 0, camPitch = 0;
    let time = 0, previousTime = 0, previousHud = -1, lastMixerTime = 0;
    let flying = false, hadLock = false, drag = null, dead = false;

/* ================= boot ================= */
    function startGame() {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x070810);
      camera = new THREE.PerspectiveCamera(62, 1, 0.1, 9000);

ship = new THREE.Group();
      ship.rotation.order = 'YXZ';
      scene.add(ship);

radar = byId('radar').getContext('2d');
      buildLights(); buildSky(); buildPlanet(); buildRocks(); buildComets();
      buildFallbackShip(); bindShipLoading(); bindInput();
      resize();
      window.addEventListener('resize', resize);
      requestAnimationFrame(frame);
    }

function resize() {
      const w = canvas.clientWidth || 1, h = canvas.clientHeight || 1;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }

/* ================= environment ================= */
    function buildLights() {
      const sun = new THREE.DirectionalLight(0xfff0dd, 2.6);
      sun.position.set(-7.2, 7.8, 4.2);
      scene.add(sun);
      scene.add(new THREE.AmbientLight(0x39405f, 1.6));
      const fill = new THREE.DirectionalLight(0x9fb4ff, 0.5);
      fill.position.set(7, -5, 4);
      scene.add(fill);
    }

function buildSky() {
      const c = document.createElement('canvas');
      c.width = c.height = 1024;
      const x = c.getContext('2d');
      x.fillStyle = '#070810';
      x.fillRect(0, 0, 1024, 1024);
      x.globalCompositeOperation = 'lighter';
      const blotch = (cx, cy, r, color) => {
        const g = x.createRadialGradient(cx, cy, 0, cx, cy, r);
        g.addColorStop(0, color);
        g.addColorStop(1, 'rgba(0,0,0,0)');
        x.fillStyle = g;
        x.fillRect(cx - r, cy - r, r * 2, r * 2);
      };
      blotch(300, 420, 320, 'rgba(40,60,140,0.32)');
      blotch(700, 300, 260, 'rgba(120,45,60,0.24)');
      blotch(560, 650, 340, 'rgba(30,45,110,0.26)');
      blotch(150, 720, 220, 'rgba(95,40,50,0.18)');
      blotch(880, 640, 210, 'rgba(40,80,150,0.20)');
      const nebula = new THREE.CanvasTexture(c);
      nebula.colorSpace = THREE.SRGBColorSpace;
      scene.add(new THREE.Mesh(
        new THREE.SphereGeometry(3600, 32, 24),
        new THREE.MeshBasicMaterial({ map: nebula, side: THREE.BackSide, depthWrite: false, fog: false })
      ));

const N = 5200;
      const pos = new Float32Array(N * 3), col = new Float32Array(N * 3);
      const v = new THREE.Vector3();
      for (let i = 0; i < N; i++) {
        v.randomDirection().multiplyScalar(rnd(2500, 3300));
        pos.set([v.x, v.y, v.z], i * 3);
        const t = Math.random(), b = 0.25 + Math.random() * 0.75;
        col.set([(0.66 + t * 0.34) * b, (0.79 + t * 0.07) * b, (1 - t * 0.14) * b], i * 3);
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      scene.add(new THREE.Points(geo, new THREE.PointsMaterial({
        size: 2, sizeAttenuation: false, vertexColors: true,
        transparent: true, depthWrite: false, fog: false
      })));
    }

function buildPlanet() {
      const pivot = new THREE.Group();
      pivot.position.set(-640, 480, -2100);
      pivot.add(new THREE.Mesh(
        new THREE.SphereGeometry(360, 48, 32),
        new THREE.MeshStandardMaterial({
          color: 0xc07042, roughness: 0.85, metalness: 0.05,
          emissive: 0x1c0d07, emissiveIntensity: 0.6
        })
      ));
      const ringGeo = new THREE.RingGeometry(430, 660, 128);
      const rp = ringGeo.attributes.position;
      const colors = new Float32Array(rp.count * 3);
      for (let i = 0; i < rp.count; i++) {
        const r = Math.hypot(rp.getX(i), rp.getY(i));
        const t = clamp((r - 430) / 230, 0, 1);
        const gap = r > 500 && r < 555 ? 0.15 : 1;
        const b = (0.45 + 0.3 * Math.sin(r * 0.9)) * gap * (1 - t * 0.3);
        colors.set([b, b * 0.78, b * 0.6], i * 3);
      }
      ringGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      const ring = new THREE.Mesh(ringGeo, new THREE.MeshBasicMaterial({
        vertexColors: true, side: THREE.DoubleSide, transparent: true,
        opacity: 0.85, depthWrite: false, fog: false
      }));
      ring.rotation.x = Math.PI / 2 - 0.32;
      pivot.add(ring);
      scene.add(pivot);
    }

function makeAsteroidGeometry(phase) {
      const geo = new THREE.IcosahedronGeometry(1, 3);
      const pos = geo.attributes.position;
      const v = new THREE.Vector3(), crater = new THREE.Vector3(0.48, 0.44, 0.76);
      for (let i = 0; i < pos.count; i++) {
        v.fromBufferAttribute(pos, i);
        const craterDot = v.dot(crater);
        const dent = 0.22 * Math.exp(-(((1 - craterDot) * 23) ** 2));
        const r = 1 - dent + 0.17 * Math.sin(v.x * 4 + v.y * 3 - v.z * 2 + phase)
                     + 0.085 * Math.sin(v.y * 9 + v.z * 6 - v.x * 5);
        v.multiplyScalar(r);
        pos.setXYZ(i, v.x * 1.14, v.y * 0.83, v.z);
      }
      geo.computeVertexNormals();
      return geo;
    }

function buildRocks() {
      for (const phase of [0.8, 2.4, 5.6]) asteroidGeos.push(makeAsteroidGeometry(phase));
      const fixed = [
        [[47, 11, -104], 18], [[-63, 30, -127], 6], [[22, -25, -65], 4.3],
        [[84, -34, -122], 11], [[-83, -37, -150], 9]
      ];
      const warm = new THREE.Color();
      for (let i = 0; i < 60; i++) {
        const origin = new THREE.Vector3();
        let radius;
        if (i < 5) { origin.fromArray(fixed[i][0]); radius = fixed[i][1]; }
        else {
          origin.set(rnd(-255, 255), rnd(-180, 180), rnd(-255, 255));
          if (origin.length() < 42) origin.multiplyScalar(1.6);
          radius = 1.2 + Math.random() ** 2 * 8;
        }
        const mesh = new THREE.Mesh(asteroidGeos[Math.floor(Math.random() * asteroidGeos.length)],
          new THREE.MeshStandardMaterial({
            color: warm.setHSL(0.07 + Math.random() * 0.05, 0.18, 0.38 + Math.random() * 0.12),
            roughness: 0.95, metalness: 0.05
          }));
        mesh.scale.setScalar(radius);
        scene.add(mesh);
        rocks.push({
          mesh, radius, origin,
          drift: new THREE.Vector3(rnd(-3, 3), rnd(-1.2, 1.2), rnd(-2, 2)),
          spin: rnd(-0.27, 0.27), phase: rnd(0, 6.28),
          relative: new THREE.Vector3()
        });
      }
    }

function buildComets() {
      const specs = [
        { origin: [74, 46, -165], curve: [0, -81, -84], direction: [-125, -48, 25], rate: 0.065 },
        { origin: [-67, -27, -150], curve: [90, 44, -90], direction: [128, 25, 26], rate: 0.051 }
      ];
      for (const s of specs) {
        const head = new THREE.Mesh(
          new THREE.SphereGeometry(3, 12, 10),
          new THREE.MeshBasicMaterial({ color: 0xbdeeff, fog: false })
        );
        const N = 176;
        const pos = new Float32Array(N * 3);
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        const tail = new THREE.Points(geo, new THREE.PointsMaterial({
          color: 0x6bd2ff, size: 1.6, transparent: true, opacity: 0.55,
          blending: THREE.AdditiveBlending, depthWrite: false, fog: false
        }));
        scene.add(head, tail);
        comets.push({
          head, tail, N, pos,
          origin: new THREE.Vector3().fromArray(s.origin),
          curve: new THREE.Vector3().fromArray(s.curve),
          direction: new THREE.Vector3().fromArray(s.direction),
          rate: s.rate, relative: new THREE.Vector3(), headWorld: new THREE.Vector3()
        });
      }
    }

function cometOffset(body, out, t) {
      const a = t * body.rate;
      out.set(
        body.curve.x * (Math.cos(a) - 1) + body.direction.x *